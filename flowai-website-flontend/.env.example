# FLOWAI storefront config
# The public URL of the site itself (used for absolute links in middleware/emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The FastAPI backend origin. Kept server-side only (never exposed to the browser).
PUBLIC_API_BASE_URL=http://localhost:8000

# Cookie names used by the auth route handlers (server-side).
FLOWAI_ACCESS_COOKIE=flowai_access
FLOWAI_REFRESH_COOKIE=flowai_refresh
